<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude local workout database, preferences, and files from automatic Google cloud backup
         so offline workouts remain strictly on-device unless exported via SAF JSON or synced to Clubs. -->
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
